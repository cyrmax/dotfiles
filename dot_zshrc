# Common interactive environment.
if [[ -r "$HOME/.config/shell/loader.sh" ]]; then
    source "$HOME/.config/shell/loader.sh"
fi

# Automatically enter isolated tmux servers for SSH and GUI.
# Do not start tmux automatically on physical Linux consoles.
if [[ -z "${TMUX:-}" && -z "${CYRMAX_NO_TMUX:-}" && -t 0 && -t 1 ]] \
    && command -v tmux >/dev/null 2>&1; then

    if [[ -n "${SSH_TTY:-}${SSH_CONNECTION:-}" ]]; then
        exec tmux -L ssh new-session -A -s main

    elif [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        exec tmux -L gui new-session -A -s main
    fi
fi

autoload -U compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Optional Zinit plugin manager.
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"

zi-install() {
    if [[ -f "$ZINIT_HOME/zinit.zsh" ]]; then
        print "Zinit is already installed."
        return 0
    fi

    if [[ -e "$ZINIT_HOME" ]]; then
        print -u2 "Zinit directory exists but installation is incomplete: $ZINIT_HOME"
        return 1
    fi

    if ! command -v git >/dev/null 2>&1; then
        print -u2 "Git is required to install Zinit."
        return 1
    fi

    mkdir -p -- "${ZINIT_HOME:h}" || return 1

    git clone --depth 1 \
        https://github.com/zdharma-continuum/zinit.git \
        "$ZINIT_HOME" || return 1

    print "Zinit installed. Restart the shell with: exec zsh"
}

if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
    if source "$ZINIT_HOME/zinit.zsh"; then
        autoload -Uz _zinit
        (( ${+_comps} )) && _comps[zinit]=_zinit

        zinit light zsh-users/zsh-completions
        zinit light zsh-users/zsh-history-substring-search
    else
        print -u2 "Warning: failed to load Zinit."
    fi
else
    print -u2 "Warning: Zinit is not installed. Run: zi-install"
fi

# Optional Starship prompt.
if command -v starship >/dev/null 2>&1; then
    if starship_init="$(starship init zsh)"; then
        eval "$starship_init"
    else
        print -u2 "Warning: Starship initialization failed."
    fi
    unset starship_init
else
    print -u2 "Warning: Starship is not installed. On Arch: sudo pacman -S starship"
fi

bindkey -e

